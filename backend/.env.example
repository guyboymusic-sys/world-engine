DATABASE_URL=******db:5432/worldengine
DATABASE_SYNC_URL=******db:5432/worldengine
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-in-production-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI model paths (populated by install_models.sh)
MODELS_DIR=/models
SKYREELS_MODEL_ID=Skywork/SkyReels-V2-I2V-14B-720P
AUDIOLDM2_MODEL_ID=cvssp/audioldm2-large
MISTRAL_MODEL_ID=mistralai/Mistral-7B-Instruct-v0.3
TORTOISE_VOICE=random

# RTMP streaming
RTMP_SERVER=rtmp://nginx-rtmp:1935
STREAM_KEY=live
YOUTUBE_STREAM_KEY=

# YouTube Data API
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Generation settings
VIDEO_FPS=24
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_DURATION_SECONDS=5
AUDIO_DURATION_SECONDS=10
AUDIO_SAMPLE_RATE=16000

# Worker concurrency
VIDEO_WORKER_CONCURRENCY=1
AUDIO_WORKER_CONCURRENCY=2
TTS_WORKER_CONCURRENCY=2
LLM_WORKER_CONCURRENCY=1
