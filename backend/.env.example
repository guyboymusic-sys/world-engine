DATABASE_URL=******db:5432/worldengine
DATABASE_SYNC_URL=******db:5432/worldengine
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-in-production-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI model paths (populated by install_models.sh)
MODELS_DIR=/models
VIDEO_MODEL_ID=damo-vilab/text-to-video-ms-1.7b
AUDIOLDM2_MODEL_ID=cvssp/audioldm2-large
MISTRAL_MODEL_ID=mistralai/Mistral-7B-Instruct-v0.3
# Tortoise stores weights in a sub-directory to avoid naming conflicts
TORTOISE_MODELS_DIR=/models/tortoise
TORTOISE_VOICE=random

# RTMP streaming
RTMP_SERVER=rtmp://nginx-rtmp:1935
STREAM_KEY=live
# ⬇ Set this to your YouTube stream key (Settings → Live → Stream key)
YOUTUBE_STREAM_KEY=

# YouTube Data API (for chat polling)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
# Live Chat ID – find it from YouTube API or from the broadcast resource
YOUTUBE_LIVE_CHAT_ID=

# Generation settings
VIDEO_FPS=24
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_DURATION_SECONDS=5
AUDIO_DURATION_SECONDS=10
AUDIO_SAMPLE_RATE=16000

# Worker concurrency
VIDEO_WORKER_CONCURRENCY=1
AUDIO_WORKER_CONCURRENCY=2
TTS_WORKER_CONCURRENCY=2
LLM_WORKER_CONCURRENCY=1

# Internal API base URL (workers call this to trigger generation)
# Docker: http://api:8000/api/v1 (default)  |  Local dev: http://localhost:8000/api/v1
API_BASE_URL=http://api:8000/api/v1

# Idle level system
# Seconds without a donation before ambient content fires automatically
IDLE_TRIGGER_SECONDS=120
IDLE_LEVEL=1
